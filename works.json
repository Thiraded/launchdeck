{
  "version": 1,
  "groups": [
    {
      "id": "examples",
      "label": "Examples",
      "members": [
        "web-client",
        "api-server",
        "docs-app"
      ]
    }
  ],
  "works": [
    {
      "id": "web-client",
      "label": "Web Client",
      "run": "detached",
      "vars": {
        "APPDIR": "D:\\examples\\web-client",
        "PORT": "5173"
      },
      "steps": [
        {
          "type": "terminal",
          "cmd": "cd /d \"%APPDIR%\""
        },
        {
          "type": "terminal",
          "cmd": "npm run dev -- --host 0.0.0.0 --port %PORT% --strictPort"
        }
      ],
      "match": "D:\\examples\\web-client",
      "detect": true,
      "icon": "⚡"
    },
    {
      "id": "api-server",
      "label": "API Server",
      "run": "detached",
      "vars": {
        "APPDIR": "D:\\examples\\api-server"
      },
      "steps": [
        {
          "type": "terminal",
          "cmd": "cd /d \"%APPDIR%\""
        },
        {
          "type": "terminal",
          "cmd": "npm run dev"
        }
      ],
      "match": "D:\\examples\\api-server",
      "detect": true,
      "icon": "⚡"
    },
    {
      "id": "docs-app",
      "label": "Docs (browser)",
      "run": "detached",
      "vars": {
        "DOCS_URL": "https://example.com/docs"
      },
      "steps": [
        {
          "type": "app",
          "cmd": "start \"\" \"%DOCS_URL%\""
        }
      ],
      "match": "example.com/docs",
      "detect": true,
      "icon": "⚡"
    }
  ],
  "settings": {
    "hotkey": "alt+w",
    "theme": "dark",
    "compact": true,
    "collapsed": []
  }
}
